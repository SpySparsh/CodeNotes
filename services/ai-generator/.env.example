# ==============================================================================
# CodeNotes AI Generator Service - Environment Configuration
# ==============================================================================

# Google Gemini API Key (required for note generation)
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use for generation (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Internal Service-to-Service Shared Secret Token (required)
# Must match the FASTAPI_SERVICE_SECRET in the consuming application (Next.js)
# Requests must pass: Authorization: Bearer <FASTAPI_SERVICE_SECRET>
FASTAPI_SERVICE_SECRET=change_me_to_a_secure_random_string

# Gemini API Request Timeout in milliseconds (default: 75000 = 75 seconds)
GEMINI_TIMEOUT_MS=75000

# Server Binding (optional, defaults shown)
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
