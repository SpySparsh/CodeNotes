# --- Required -----------------------------------------------------------------

# PostgreSQL connection string.
# In production, include the SSL parameters required by your provider, e.g.:
#   postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/codenotes

# Google Gemini API key.
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Public Configuration (Safe for browser/public)
# Obtain from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: Supadata API key (Primary YouTube transcript provider)
# Obtain from: https://supadata.ai
SUPADATA_API_KEY=

# Optional: Inngest Background Worker Keys
# Obtain from: Inngest Dashboard -> Event Keys & Signing Keys
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Optional: Error Monitoring & Reporting (Sentry)
# Server-side Sentry DSN:
SENTRY_DSN=
# Browser-side Sentry DSN (Safe for public exposure):
NEXT_PUBLIC_SENTRY_DSN=
# Sentry Build & Sourcemap Upload (Optional):
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional: PostgreSQL Root CA Certificate (PEM string format).
# Required in production when connecting to Supabase (e.g. via port 6543 pooler)
# or any PostgreSQL provider using a custom or self-signed Root CA.
# Obtain from Supabase Dashboard -> Project Settings -> Database -> SSL Configuration.
# Never expose this variable via NEXT_PUBLIC_*.
DATABASE_CA_CERT=

# Optional: Prometheus Metrics Scrape Authentication (/api/metrics)
# Leave commented out or unset for standard unauthenticated local scraping by Prometheus.
# In Preview and Production (VERCEL_ENV=preview/production or NODE_ENV=production),
# METRICS_SECRET is REQUIRED. Scrapes must provide: Authorization: Bearer <METRICS_SECRET>
# If missing or blank in Preview/Production, /api/metrics fails closed with HTTP 503.
# In local development, if unset or blank, /api/metrics allows unauthenticated scraping.
# METRICS_SECRET=your-metrics-secret-token

# Optional: Product Analytics (PostHog - Client-side only)
# Obtain from: PostHog Dashboard -> Project Settings -> Project API Key
# If NEXT_PUBLIC_POSTHOG_KEY is unset or blank, analytics safely no-ops with 0 outbound requests.
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog Ingestion Host (defaults to https://us.i.posthog.com if omitted):
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Testing & Test Automation ------------------------------------------------

# Required for local PostgreSQL Row Level Security (RLS) integration tests:
# Must point to an isolated local PostgreSQL database strictly named 'codenotes_test'
# on localhost/127.0.0.1. Safety guards will reject production or remote hosts.
# Used by: npm run test:integration:rls
TEST_DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/codenotes_test

# Optional: Playwright End-to-End Live User Credentials
# Used by live browser smoke tests (e2e/auth-smoke.spec.ts) to verify real Supabase login.
# If omitted or blank, test suites fall back to deterministic mock authentication.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# --- Auto-set & Platform Metadata -- do not override manually -----------------

# NODE_ENV is set automatically by Next.js:
#   development  ->  next dev
#   production   ->  next build / next start
# Do not set this manually.

# VERCEL_GIT_COMMIT_SHA and VERCEL_ENV are automatically provided by the Vercel runtime.
# They are consumed by /api/health to expose deployment release metadata, and by the
# automated post-deployment smoke test (.github/workflows/post-deploy-smoke.yml).
# Do not configure these manually.
