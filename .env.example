# --- Required -----------------------------------------------------------------

# PostgreSQL connection string.
# In production, include the SSL parameters required by your provider, e.g.:
#   postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/codenotes

# Google Gemini API key.
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supadata API key (Primary transcript provider for YouTube videos).
# Obtain from: https://supadata.ai
SUPADATA_API_KEY=your_supadata_api_key_here

# Supabase Public Configuration (Safe for browser/public)
# Obtain from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Inngest Configuration
# In local development, Inngest Dev Server works without keys.
# In production on Vercel, obtain from your Inngest Cloud Dashboard:
#   INNGEST_EVENT_KEY=your_inngest_event_key
#   INNGEST_SIGNING_KEY=your_inngest_signing_key
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Optional: PostgreSQL Root CA Certificate (PEM string format).
# Required in production when connecting to Supabase (e.g. via port 6543 pooler)
# or any PostgreSQL provider using a custom or self-signed Root CA.
# Obtain from Supabase Dashboard -> Project Settings -> Database -> SSL Configuration.
# Never expose this variable via NEXT_PUBLIC_*.
DATABASE_CA_CERT=

# --- Auto-set -- do not override ----------------------------------------------

# NODE_ENV is set automatically by Next.js:
#   development  ->  next dev
#   production   ->  next build / next start
# Do not set this manually.
